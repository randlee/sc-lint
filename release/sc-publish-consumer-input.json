{
  "schema_version": 1,
  "project": {
    "name": "sc-lint",
    "archive_prefix": "sc-lint",
    "description": "Reusable repository policy enforcement lint tools for Rust workspaces",
    "homepage": "https://github.com/randlee/sc-lint",
    "license": "MIT",
    "workspace_toml": "Cargo.toml",
    "rust_toolchain": "1.94.1",
    "readme_dependency_crate": "sc-lint",
    "renderer_archive_path": "bin/sc-lint"
  },
  "release_targets": [
    {
      "target": "x86_64-unknown-linux-gnu",
      "os": "ubuntu-latest",
      "archive": "tar.gz"
    },
    {
      "target": "x86_64-apple-darwin",
      "os": "macos-latest",
      "archive": "tar.gz"
    },
    {
      "target": "aarch64-apple-darwin",
      "os": "macos-latest",
      "archive": "tar.gz"
    },
    {
      "target": "x86_64-pc-windows-msvc",
      "os": "windows-latest",
      "archive": "zip"
    }
  ],
  "crates": [
    {
      "artifact": "sc-lint-directives",
      "package": "sc-lint-directives",
      "cargo_toml": "crates/sc-lint-directives/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 1,
      "preflight_check": "full",
      "wait_after_publish_seconds": 15,
      "verify_install": false
    },
    {
      "artifact": "sc-lint-schema",
      "package": "sc-lint-schema",
      "cargo_toml": "crates/sc-lint-schema/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 2,
      "preflight_check": "full",
      "wait_after_publish_seconds": 15,
      "verify_install": false
    },
    {
      "artifact": "sc-lint-analyzer-support",
      "package": "sc-lint-analyzer-support",
      "cargo_toml": "crates/sc-lint-analyzer-support/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 3,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 15,
      "verify_install": false
    },
    {
      "artifact": "sc-lint-attributes",
      "package": "sc-lint-attributes",
      "cargo_toml": "crates/sc-lint-attributes/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 4,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 0,
      "verify_install": false
    },
    {
      "artifact": "sc-lint-boundary",
      "package": "sc-lint-boundary",
      "cargo_toml": "crates/sc-lint-boundary/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 5,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 15,
      "verify_install": true
    },
    {
      "artifact": "sc-lint-portability",
      "package": "sc-lint-portability",
      "cargo_toml": "crates/sc-lint-portability/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 6,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 0,
      "verify_install": true
    },
    {
      "artifact": "sc-lint-runtime",
      "package": "sc-lint-runtime",
      "cargo_toml": "crates/sc-lint-runtime/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 7,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 0,
      "verify_install": true
    },
    {
      "artifact": "sc-lint",
      "package": "sc-lint",
      "cargo_toml": "crates/sc-lint/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 8,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 0,
      "verify_install": true
    }
  ],
  "release_binaries": [
    {
      "name": "sc-lint",
      "bundled_paths": [
        {
          "source": "docs-bundle",
          "destination": "share/doc/sc-lint",
          "homebrew_destination_components": [
            "pkgshare"
          ]
        }
      ]
    },
    {
      "name": "sc-lint-boundary"
    },
    {
      "name": "sc-lint-portability"
    },
    {
      "name": "sc-lint-runtime"
    }
  ],
  "python_packages": [
    {
      "artifact": "sc-lint-py",
      "package": "sc-lint",
      "manifest": "bindings/sc-lint-py/pyproject.toml",
      "module": "sc_lint",
      "publish": "pypi"
    }
  ],
  "python_distributions": [
    {
      "name": "sc-lint",
      "source": "bindings/sc-lint-py",
      "cargo_manifest": "bindings/sc-lint-py/Cargo.toml",
      "module_path": "bindings/sc-lint-py/python/sc_lint",
      "sdist": true,
      "wheels": [
        "ubuntu-latest",
        "macos-latest",
        "windows-latest"
      ]
    }
  ],
  "channels": {
    "pypi": {
      "workflow": "pypi-publish.yml",
      "dispatch_inputs": {
        "target": "production"
      },
      "credential_rehearsal_inputs": {
        "target": "testpypi"
      },
      "test_repository": "testpypi",
      "production_repository": "pypi"
    },
    "homebrew": {
      "workflow": "homebrew-publish.yml",
      "dispatch_inputs": {},
      "tap_repository": "randlee/homebrew-tap",
      "renderer_target": "x86_64-unknown-linux-gnu",
      "formulas": [
        {
          "path": "Formula/sc-lint.rb",
          "template": "release/homebrew/formula.rb.j2",
          "class": "ScLint",
          "binaries": [
            "sc-lint",
            "sc-lint-boundary",
            "sc-lint-portability",
            "sc-lint-runtime"
          ],
          "test_command": "--version",
          "test_output": "sc-lint",
          "release_track": "stable",
          "test_binary": "sc-lint"
        }
      ],
      "assets": [
        {
          "key": "macos_arm",
          "target": "aarch64-apple-darwin"
        },
        {
          "key": "macos_intel",
          "target": "x86_64-apple-darwin"
        },
        {
          "key": "linux",
          "target": "x86_64-unknown-linux-gnu"
        }
      ]
    }
  },
  "documentation_bundle": {
    "source_directory": "docs-bundle",
    "package_directory": "sc-lint-docs",
    "required_files": [
      "manifest.toml",
      "README.md",
      "installation.md",
      "using-sc-lint.md",
      "configuration.md",
      "just-setup.md",
      "ci.md",
      "upgrade.md",
      "troubleshooting.md",
      "best-practices.md",
      "packages/sc-lint.md",
      "packages/sc-lint-attributes.md",
      "packages/sc-lint-analyzer-support.md",
      "packages/sc-lint-boundary.md",
      "packages/sc-lint-directives.md",
      "packages/sc-lint-portability.md",
      "packages/sc-lint-runtime.md",
      "packages/sc-lint-schema.md"
    ]
  }
}
