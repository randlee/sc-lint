{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randlee/sc-lint/blob/develop/crates/sc-lint-schema/schema/analyzer-report-v1.schema.json",
  "title": "sc-lint analyzer report v1",
  "description": "JSON emitted by Rust analyzer backends and normalized by sc-lint.",
  "type": "object",
  "required": [
    "tool",
    "version",
    "schema_version",
    "status",
    "scanned_crates",
    "findings"
  ],
  "properties": {
    "tool": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail"] },
    "scanned_crates": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "kind", "message", "owner_ids", "node_ids"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "owner_ids": { "type": "array", "items": { "type": "string" } },
          "node_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
