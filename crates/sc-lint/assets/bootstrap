#!/bin/sh
# Product-owned consumer bootstrap. Generated by `sc-lint init --just` in E.3.
set -eu

usage() {
    printf '%s\n' 'usage: .sc-lint/bootstrap <ensure|setup|upgrade> --config sc-lint.toml [--check] [--dry-run]' >&2
    exit 2
}

command_name="${1:-}"
[ -n "$command_name" ] || usage
shift
config=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --config)
            [ "$#" -ge 2 ] || usage
            config="$2"
            shift 2
            ;;
        --check|--dry-run)
            break
            ;;
        *) usage ;;
    esac
done

[ -n "$config" ] || usage
binary="${SC_LINT_BIN:-sc-lint}"

if ! command -v "$binary" >/dev/null 2>&1; then
    printf '%s\n' "compatibility.check: could not find sc-lint binary \`$binary\` (CLI.SC_LINT_BINARY_NOT_FOUND)" >&2
    printf '%s\n' 'Run `just setup` (or your repository installer) to create or repair a compatible installation.' >&2
    printf '%s\n' 'Docs: sc-lint docs setup' >&2
    exit 5
fi

case "$command_name" in
    ensure)
        exec "$binary" --config "$config" compatibility check
        ;;
    setup)
        exec "$binary" --config "$config" setup "$@"
        ;;
    upgrade)
        exec "$binary" --config "$config" upgrade "$@"
        ;;
    *) usage ;;
esac
