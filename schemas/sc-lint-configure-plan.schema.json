{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randlee/sc-lint/blob/main/schemas/sc-lint-configure-plan.schema.json",
  "title": "sc-lint Configure Plan v1",
  "description": "The no-write, ordered change plan consumed unchanged by later apply and workflow transformers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "operations", "conflicts", "manual_steps"],
  "properties": {
    "schema_version": {"const": "v1"},
    "plan_id": {"$ref": "#/$defs/sha256Digest"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "preconditions": {"type": "array", "items": {"$ref": "#/$defs/precondition"}},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/operationId"}},
    "manual_steps": {"type": "array", "items": {"$ref": "#/$defs/manualStep"}}
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9A-Fa-f]{6,64}$"
    },
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+"},
        "source_digest": {"anyOf": [{"$ref": "#/$defs/sha256Digest"}, {"type": "null"}]}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "path", "kind"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+"},
        "kind": {"enum": ["propose_create", "propose_update", "propose_remove", "needs_confirmation", "manual_conflict"]},
        "artifact_kind": {"enum": ["toml", "justfile", "shell", "json", "workflow_yaml"]},
        "reason": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["keep_existing", "generate_managed_import", "generate_managed_workflow", "review_patch"]}},
        "conflict": {"$ref": "#/$defs/conflict"},
        "exportable_patch": {"$ref": "#/$defs/exportablePatch"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "needs_confirmation"}}}, "then": {"required": ["reason", "choices"]}},
        {"if": {"properties": {"kind": {"const": "manual_conflict"}}}, "then": {"required": ["conflict", "exportable_patch"]}}
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "recovery"],
      "properties": {
        "code": {"type": "string", "pattern": "^CLI\\.CONFIGURE_[A-Z_]+$"},
        "observed_digest": {"$ref": "#/$defs/sha256Digest"},
        "recovery": {"type": "string", "minLength": 1}
      }
    },
    "exportablePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "content"],
      "properties": {
        "format": {"const": "unified-diff"},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+"},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "manualStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "action"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "action": {"type": "string", "minLength": 1}
      }
    }
  }
}
