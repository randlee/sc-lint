#!/bin/sh
# Managed by sc-lint; regenerate with `sc-lint init --just`.
# Product-owned consumer bootstrap. Generated by `sc-lint init --just`.
set -eu

usage() {
    printf '%s\n' 'usage: .sc-lint/bootstrap <setup|lint|test|upgrade> --config sc-lint.toml [--check] [--dry-run]; .sc-lint/bootstrap exec [--config sc-lint.toml] -- <argv...>' >&2
    exit 2
}

operation="${1:-}"
[ -n "$operation" ] || usage
shift

# Directly execute a managed product command or an arbitrary consumer command.
# This path intentionally does not run setup or profile dispatch.
if [ "$operation" = exec ]; then
    exec_config=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --config)
                [ "$#" -ge 2 ] || usage
                exec_config="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *) usage ;;
        esac
    done
    [ "$#" -gt 0 ] || usage

    if [ -n "${SC_LINT_BIN:-}" ]; then
        # Resolve the override as a command, like resolve_product_binary and
        # bootstrap.ps1: a bare name is a PATH lookup, a path is used as given.
        # An unresolved override fails here; it never falls back.
        exec_binary="$(command -v "$SC_LINT_BIN" 2>/dev/null || :)"
        case "$exec_binary" in
            */*) ;;
            *)
                printf '%s\n' "sc-lint binary is unavailable at $SC_LINT_BIN; run just setup" >&2
                exit 1
                ;;
        esac
    else
        exec_install_dir="${SC_LINT_INSTALL_DIR:-${XDG_DATA_HOME:-${HOME:-}/.local/share}/sc-lint/bin}"
        exec_binary="$exec_install_dir/sc-lint"
    fi
    if [ ! -f "$exec_binary" ] || [ ! -x "$exec_binary" ]; then
        printf '%s\n' "sc-lint binary is unavailable at $exec_binary; run just setup" >&2
        exit 1
    fi

    export SC_LINT_BIN="$exec_binary"
    case "$exec_binary" in
        */*) exec_binary_dir="${exec_binary%/*}"; [ -n "$exec_binary_dir" ] || exec_binary_dir="/" ;;
        *) exec_binary_dir="." ;;
    esac
    PATH="$exec_binary_dir:${PATH:-}"
    export PATH
    if [ "$1" = sc-lint ]; then
        shift
        if [ -n "$exec_config" ]; then
            exec "$exec_binary" --config "$exec_config" "$@"
        fi
        exec "$exec_binary" "$@"
    fi
    exec "$@"
fi

config=""
selector=""
flags=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --config)
            [ "$#" -ge 2 ] || usage
            config="$2"
            shift 2
            ;;
        --check|--dry-run) flags="$flags $1"; shift ;;
        *) [ -z "$selector" ] || usage; selector="$1"; shift ;;
    esac
done
# Re-expose the mode flags as "$@" for the setup/upgrade paths below.
# shellcheck disable=SC2086
set -- $flags

[ -n "$config" ] || usage
case "$operation" in setup|lint|test|upgrade) ;; *) usage ;; esac
case "$operation" in lint|test) ;; *) [ -z "$selector" ] || usage ;; esac

minimum_version() {
    sed -n 's/^[[:space:]]*minimum_version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$config" | head -n 1
}

install_dir="${SC_LINT_INSTALL_DIR:-${XDG_DATA_HOME:-${HOME:-}/.local/share}/sc-lint/bin}"
managed_binary="$install_dir/sc-lint"
product_binary=""
product_binary_override="false"

# Python helper package (sc_lint wheel) provisioned next to the config file.
venv_dir="$(cd "$(dirname "$config")" && pwd)/.sc-lint/venv"
venv_python="$venv_dir/bin/python3"
# Consumer-declared tools (ADR-017 change 6) persist in the installer input next
# to the config file; the managed wheel helper sc_lint.setup_tools owns them.
install_input="$(cd "$(dirname "$config")" && pwd)/.sc-lint/install.json"
# Seed-interpreter probe (stdlib JSON only): exit 0 when the tools object is
# absent or every collection is empty, 3 when the managed helper must run.
tools_probe=$(cat <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as handle:
        data = json.load(handle)
except (OSError, ValueError):
    sys.exit(3)
tools = data.get('tools', {}) if isinstance(data, dict) else None
empty = {'cargo': {}, 'rustup_targets': []}
declared = not isinstance(tools, dict) or any(key not in empty or tools[key] != empty[key] for key in tools)
sys.exit(3 if declared else 0)
PY
)

host_python() {
    command -v python3 2>/dev/null || command -v python 2>/dev/null
}

venv_ready() {
    [ -x "$venv_python" ] && "$venv_python" -c 'import sys, sc_lint
parse = lambda value: tuple(int(part) for part in value.split("+")[0].split(".")[:3])
sys.exit(0 if parse(sc_lint.__version__) >= parse(sys.argv[1]) else 1)' "$1" >/dev/null 2>&1
}

venv_mode() {
    for argument in "$@"; do
        case "$argument" in
            --check) echo check; return ;;
            --dry-run) echo dry-run; return ;;
        esac
    done
    echo install
}

# provision_venv <install|check|dry-run>: ensure .sc-lint/venv holds sc-lint>=minimum_version.
# SC_LINT_WHEEL_DIR selects an offline wheel directory instead of PyPI.
provision_venv() {
    version="$(minimum_version)"
    if venv_ready "$version"; then return 0; fi
    case "$1" in
        check)
            printf '%s\n' "setup: $venv_dir does not provide sc-lint>=$version (CLI.SC_LINT_PYTHON_UNAVAILABLE)" >&2
            return 4
            ;;
        dry-run)
            printf '%s\n' "setup: would install sc-lint==$version into $venv_dir"
            return 0
            ;;
    esac
    if [ ! -x "$venv_python" ]; then
        python="$(host_python)"
        if [ -z "$python" ] || ! "$python" -m venv "$venv_dir"; then
            printf '%s\n' "setup: could not create $venv_dir (CLI.SC_LINT_PYTHON_UNAVAILABLE)" >&2
            return 4
        fi
    fi
    if [ -n "${SC_LINT_WHEEL_DIR:-}" ]; then
        set -- --no-index --find-links "$SC_LINT_WHEEL_DIR"
    else
        set --
    fi
    if ! "$venv_python" -m pip install --quiet --disable-pip-version-check "$@" "sc-lint==$version"; then
        printf '%s\n' "setup: could not install sc-lint==$version into $venv_dir (CLI.SC_LINT_PYTHON_UNAVAILABLE)" >&2
        return 4
    fi
}

# provision_tools <install|check|dry-run>: run the managed sc_lint.setup_tools
# helper only when the persisted installer input declares tools. Dry-run and
# check forward --check and never provision the helper or any tool.
provision_tools() {
    [ -f "$install_input" ] || return 0
    probe_python="$(host_python || true)"
    if [ -z "$probe_python" ] && [ -x "$venv_python" ]; then probe_python="$venv_python"; fi
    if [ -z "$probe_python" ]; then
        printf '%s\n' "setup: no Python is available to read the tools declaration in $install_input (SETUP_TOOLS.INSPECTION_UNAVAILABLE); install Python 3, then run just setup" >&2
        return 4
    fi
    tools_status=0
    "$probe_python" -c "$tools_probe" "$install_input" || tools_status=$?
    case "$tools_status" in
        0) return 0 ;;
        3) ;;
        *)
            printf '%s\n' "setup: could not read the tools declaration in $install_input (SETUP_TOOLS.INSPECTION_UNAVAILABLE); run just setup" >&2
            return 4
            ;;
    esac
    if [ ! -x "$venv_python" ] || ! "$venv_python" -c 'import sc_lint.setup_tools' >/dev/null 2>&1; then
        if [ "$1" = install ]; then
            printf '%s\n' "setup: $install_input declares tools, but the sc-lint wheel in $venv_dir does not provide sc_lint.setup_tools (SETUP_TOOLS.INSPECTION_UNAVAILABLE); raise minimum_version, then run just setup" >&2
        else
            printf '%s\n' "setup: $install_input declares tools that cannot be inspected because sc_lint.setup_tools is unavailable in $venv_dir (SETUP_TOOLS.INSPECTION_UNAVAILABLE); run just setup" >&2
        fi
        return 4
    fi
    if [ "$1" = install ]; then
        "$venv_python" -m sc_lint.setup_tools --config "$config"
    else
        "$venv_python" -m sc_lint.setup_tools --config "$config" --check
    fi
}

resolve_product_binary() {
    product_binary_override="false"
    if [ -n "${SC_LINT_BIN:-}" ] && command -v "$SC_LINT_BIN" >/dev/null 2>&1; then
        product_binary="$(command -v "$SC_LINT_BIN")"
        product_binary_override="true"
    elif [ -x "$managed_binary" ]; then
        product_binary="$managed_binary"
    elif command -v sc-lint >/dev/null 2>&1; then
        product_binary="$(command -v sc-lint)"
    else
        product_binary=""
    fi
}

bootstrap_install() {
    command="$1"
    shift
    version="$(minimum_version)"
    [ -n "$version" ] || {
        printf '%s\n' "setup: could not read minimum_version from $config (CLI.SC_LINT_CONFIG_MALFORMED)" >&2
        exit 3
    }
    case "$(uname -s)/$(uname -m)" in
        Linux/x86_64) target="x86_64-unknown-linux-gnu" ;;
        Darwin/x86_64) target="x86_64-apple-darwin" ;;
        Darwin/arm64) target="aarch64-apple-darwin" ;;
        *)
            printf '%s\n' "setup: no verified sc-lint release for $(uname -s)/$(uname -m) (CLI.SC_LINT_INSTALL_UNSUPPORTED_PLATFORM)" >&2
            exit 4
            ;;
    esac
    archive="sc-lint_${version}_${target}.tar.gz"
    base="${SC_LINT_RELEASE_BASE_URL:-https://github.com/randlee/sc-lint/releases/download}"
    release_url="${base%/}/v${version}"
    staging="$(mktemp -d "${TMPDIR:-/tmp}/sc-lint-bootstrap.XXXXXX")"
    cleanup() { rm -rf "$staging"; }
    trap cleanup EXIT HUP INT TERM
    if ! curl --fail --location --retry 3 --output "$staging/checksums.txt" "$release_url/checksums.txt"; then
        printf '%s\n' "setup: could not download checksum manifest (CLI.SC_LINT_RELEASE_UNAVAILABLE)" >&2
        exit 4
    fi
    if ! curl --fail --location --retry 3 --output "$staging/$archive" "$release_url/$archive"; then
        printf '%s\n' "setup: could not download $archive (CLI.SC_LINT_RELEASE_UNAVAILABLE)" >&2
        exit 4
    fi
    expected="$(awk -v name="$archive" '$2 == name || $2 == "*" name { print $1; exit }' "$staging/checksums.txt")"
    [ -n "$expected" ] || {
        printf '%s\n' "setup: checksum manifest did not contain $archive (CLI.SC_LINT_RELEASE_UNAVAILABLE)" >&2
        exit 4
    }
    if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$staging/$archive" | awk '{print $1}')"; else actual="$(shasum -a 256 "$staging/$archive" | awk '{print $1}')"; fi
    [ "$actual" = "$expected" ] || {
        printf '%s\n' "setup: SHA-256 verification failed for $archive (CLI.SC_LINT_RELEASE_CHECKSUM_MISMATCH)" >&2
        exit 4
    }
    if ! mkdir -p "$staging/extract"; then
        printf '%s\n' "setup: could not create release launcher directory (CLI.SC_LINT_INSTALL_PERMISSION_DENIED)" >&2
        exit 4
    fi
    if ! tar -xzf "$staging/$archive" -C "$staging/extract"; then
        printf '%s\n' "setup: could not extract $archive (CLI.SC_LINT_RELEASE_UNAVAILABLE)" >&2
        exit 4
    fi
    launcher="$staging/extract/sc-lint"
    if [ ! -f "$launcher" ]; then
        launcher="$staging/extract/sc-lint_${version}_${target}/bin/sc-lint"
    fi
    [ -f "$launcher" ] || {
        printf '%s\n' "setup: release archive did not contain sc-lint (CLI.SC_LINT_RELEASE_UNAVAILABLE)" >&2
        exit 4
    }
    # The extracted release is only a launcher. Its Rust installer owns the
    # managed-target backup, activation, rollback, and version verification.
    "$launcher" --config "$config" "$command" "$@"
}

ensure_product() {
    resolve_product_binary
    if [ -z "$product_binary" ]; then
        bootstrap_install setup "$@"
        product_binary="$managed_binary"
    fi
    if "$product_binary" --config "$config" compatibility check --binary "$product_binary"; then return; fi
    if [ "$product_binary" = "$managed_binary" ]; then
        for argument in "$@"; do
            if [ "$argument" = "--check" ] || [ "$argument" = "--dry-run" ]; then
                "$product_binary" --config "$config" setup "$@"
                return
            fi
        done
        bootstrap_install setup "$@"
    elif [ "$product_binary_override" = "true" ]; then
        "$product_binary" --config "$config" setup "$@"
    else
        for argument in "$@"; do
            if [ "$argument" = "--check" ] || [ "$argument" = "--dry-run" ]; then
                "$product_binary" --config "$config" setup "$@"
                return
            fi
        done
        bootstrap_install setup "$@"
    fi
    if [ -x "$managed_binary" ]; then product_binary="$managed_binary"; fi
    return 0
}

activate_product_env() {
    export SC_LINT_BIN="$product_binary"
    PATH="$(dirname "$product_binary"):$PATH"; export PATH
}

case "$operation" in
    setup)
        ensure_product "$@"
        "$product_binary" --config "$config" setup "$@" || exit $?
        setup_mode="$(venv_mode "$@")"
        provision_venv "$setup_mode" || exit $?
        provision_tools "$setup_mode"
        exit $?
        ;;
    lint)
        ensure_product "$@"
        activate_product_env
        provision_venv install || exit $?
        if [ -n "$selector" ]; then exec "$product_binary" lint --consumer --config "$config" ci --profile "$selector"; fi
        exec "$product_binary" lint --consumer --config "$config" ci
        ;;
    test)
        ensure_product "$@"
        activate_product_env
        provision_venv install || exit $?
        if [ -n "$selector" ]; then exec "$product_binary" test --config "$config" "$selector"; fi
        exec "$product_binary" test --config "$config"
        ;;
    upgrade)
        resolve_product_binary
        if [ -z "$product_binary" ]; then
            bootstrap_install upgrade "$@"
            exit $?
        fi
        if ! "$product_binary" --config "$config" compatibility check --binary "$product_binary"; then
            if [ "$product_binary" = "$managed_binary" ]; then
                for argument in "$@"; do
                    if [ "$argument" = "--check" ] || [ "$argument" = "--dry-run" ]; then
                        exec "$product_binary" --config "$config" upgrade "$@"
                    fi
                done
                bootstrap_install upgrade "$@"
                exit $?
            elif [ "$product_binary_override" = "false" ]; then
                has_nonmutating_flag="false"
                for argument in "$@"; do
                    if [ "$argument" = "--check" ] || [ "$argument" = "--dry-run" ]; then
                        has_nonmutating_flag="true"
                    fi
                done
                if [ "$has_nonmutating_flag" = "false" ]; then
                    bootstrap_install upgrade "$@"
                    exit $?
                fi
            fi
        fi
        "$product_binary" --config "$config" upgrade "$@" || exit $?
        provision_venv "$(venv_mode "$@")"
        exit $?
        ;;
esac
