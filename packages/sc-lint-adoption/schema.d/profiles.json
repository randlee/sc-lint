{
  "properties": {
    "profiles": {
      "additionalProperties": {
        "oneOf": [
          {
            "description": "Existing shape: a command argv array, rendered verbatim.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          {
            "description": "Object lint step matching ConsumerProfileStepFile; the map key supplies the step name unless name is explicitly set.",
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "name": { "type": "string", "pattern": ".*\\S.*" },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "platform": { "type": "string", "enum": ["linux", "macos", "windows"] },
              "target": { "type": "string" },
              "after_all": { "type": "boolean" },
              "env": {
                "type": "object",
                "propertyNames": { "type": "string", "minLength": 1, "pattern": "^[^=\\u0000]+$" },
                "additionalProperties": { "type": "string" }
              },
              "cwd": { "type": "string", "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$" }
            }
          }
        ]
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "description": "Legacy command argv array; the map key supplies the step name.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          {
            "description": "Test step object; name is supplied by the map key; only command and after_all are accepted by test rows.",
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "after_all": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "lint_profiles": {
      "description": "Optional named lint profiles: profile name to ordered list of step names from `profiles`. Shape only; the sc-lint binary rejects unknown, duplicate, empty, and colliding members.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
